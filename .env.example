# Copy this file to .env for local development (never commit the real .env file).

# MongoDB connection string.
# Local MongoDB:   mongodb://localhost:27017/joymaalaxmi
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster-url>/joymaalaxmi?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/joymaalaxmi

# Flask session secret -- set this to a long random string in production.
SECRET_KEY=change-this-secret-key-in-production

# Admin panel login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
